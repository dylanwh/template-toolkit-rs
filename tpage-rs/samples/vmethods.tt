[% s = '  Hello, World  ' -%]
[[% s.trim %]] [[% s.length %]] [[% s.upper %]] [[% s.lower %]] [[% s.collapse %]]
[% t = 'abc'; t.repeat(3) %] [% t = 'a-b-c'; t.split('-').join('+') %] [% t = 'foo bar'; t.replace('o', '0') %]
[% t = 'hello world'; t.match('(\w+) (\w+)').join('|') %] [% t = 'aaa'; t.search('a+') ? 'found' : 'no' %]
[% t = 'ucfirst'; t.ucfirst %] [% t = 'LCFIRST'; t.lcfirst %] [% t = 'abcdef'; t.substr(2, 3) %] [% t.defined %]
[% list = [3, 1, 4, 1, 5, 9, 2, 6] -%]
[% list.size %] [% list.max %] [% list.first %] [% list.last %] [% list.sort.join(',') %] [% list.nsort.reverse.join(',') %]
[% list.unique.join(',') %] [% list.grep('^[1-4]$').join(',') %] [% list.slice(1, 3).join(',') %]
[% words = ['pear', 'Apple', 'fig'] %][% words.sort.join(' ') %] [% words.join(', ') %]
[% h = { one => 1, two => 2, three => 3 } -%]
[% h.keys.sort.join(',') %] [% h.values.nsort.join(',') %] [% h.size %] [% h.exists('two') %] [% h.item('three') %]
[% FOREACH k IN h.sort %][% k %] [% END %]
[% h.pairs.0.key %] [% list.push(7); list.size %] [% list.pop %] [% list.shift %] [% list.join('') %]
