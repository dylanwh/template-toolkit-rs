[% BLOCK greet %]Hello, [% who or 'nobody' %]![% END -%]
[% INCLUDE greet who='Alice' %]
[% PROCESS greet who='Bob' %]
[% INCLUDE lib/header.tt title='Sample' %]
[% WRAPPER lib/box.tt %]wrapped content[% END %]
[% MACRO bold(t) BLOCK %]<b>[% t %]</b>[% END -%]
[% bold('macro') %] [% bold('again') %]
[% x = 'outer' %][% INCLUDE lib/setx.tt %][% x %] [% PROCESS lib/setx.tt %][% x %]
[% c = BLOCK %]captured [% 1 + 1 %][% END %][% c | upper %]
