[% USE date -%]
[% date.format(0, '%Y-%m-%d %H:%M:%S %a %b %j') %]
[% date.format('12:30:00 25/12/2020', '%A %d %B %Y %H:%M') %]
[% date.format(1700000000, format => '%c', gmt => 1) %]
[% USE Math %][% Math.sqrt(16) %] [% Math.abs(-3) %] [% Math.int(3.7) %]
[% USE String('abc') %][% String.append('def').upper %] [% String.length %]
[% USE table = Table([1..9], rows=3) %][% FOREACH r IN table.rows %][% r.join(' ') %];[% END %]
[% USE f = format('%05.2f') %][% f(3.14159) %]
[% USE url = url('http://x.com/', a='1') %][% url(b='2 3') %]
[% USE iterator = Iterator(['x','y']) %][% FOREACH i IN iterator %][% i %][% END %]
