[% FOREACH i IN [1..5] -%]
[% loop.index %]/[% loop.count %]/[% loop.size %] first=[% loop.first %] last=[% loop.last %] [% i %]
[% END -%]
[% FOREACH pair IN { b => 2, a => 1, c => 3 } -%]
[% pair.key %]=[% pair.value %]
[% END -%]
[% n = 0; WHILE n < 3; n = n + 1 %][% n %],[% END %]
[% FOREACH x IN ['a','b','c','d'] %][% NEXT IF x == 'b' %][% LAST IF x == 'd' %][% x %][% END %]
[% FOREACH row IN [[1,2],[3,4]] %][% FOREACH c IN row %][% c %][% END %];[% END %]
[% SWITCH 'beta' %][% CASE 'alpha' %]A[% CASE ['beta', 'gamma'] %]B or G[% CASE %]other[% END %]
